<!-- src/templates/contact-notification.ejs -->
<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>New Contact Message</title>
    <style>
      body {
        font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
        background-color: #f5f5f4;
        margin: 0;
        padding: 0;
        color: #44403c;
      }
      .container {
        max-width: 600px;
        margin: 40px auto;
        background-color: #ffffff;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
      }
      .header {
        background: linear-gradient(135deg, #dda200 0%, #b38600 100%);
        padding: 40px 20px;
        text-align: center;
      }
      .logo-container {
        background-color: white;
        width: 60px;
        height: 60px;
        margin: 0 auto 15px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
      }
      .header h1 {
        color: white;
        margin: 0;
        font-size: 24px;
        font-weight: bold;
      }
      .header p {
        color: rgba(255, 255, 255, 0.9);
        margin: 10px 0 0;
        font-size: 14px;
      }
      .content {
        padding: 40px 30px;
      }
      .badge {
        display: inline-block;
        background: #fef3c7;
        color: #92400e;
        padding: 6px 14px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
        margin-bottom: 20px;
      }
      .sender-info {
        background: linear-gradient(135deg, #fafaf9 0%, #f5f5f4 100%);
        border-radius: 12px;
        padding: 24px;
        margin-bottom: 24px;
        border-left: 4px solid #dda200;
      }
      .sender-info h3 {
        margin: 0 0 16px;
        color: #1c1917;
        font-size: 16px;
        font-weight: 600;
      }
      .info-row {
        display: flex;
        margin-bottom: 12px;
        font-size: 14px;
      }
      .info-row:last-child {
        margin-bottom: 0;
      }
      .info-label {
        width: 80px;
        color: #78716c;
        font-weight: 500;
      }
      .info-value {
        color: #1c1917;
        font-weight: 500;
      }
      .info-value a {
        color: #dda200;
        text-decoration: none;
      }
      .message-box {
        background: #ffffff;
        border: 1px solid #e7e5e4;
        border-radius: 12px;
        padding: 24px;
        margin-bottom: 24px;
      }
      .message-box h3 {
        margin: 0 0 8px;
        color: #1c1917;
        font-size: 16px;
        font-weight: 600;
      }
      .message-subject {
        color: #dda200;
        font-weight: 600;
        font-size: 18px;
        margin-bottom: 16px;
        padding-bottom: 16px;
        border-bottom: 1px dashed #e7e5e4;
      }
      .message-content {
        color: #44403c;
        line-height: 1.7;
        font-size: 15px;
        white-space: pre-wrap;
      }
      .action-buttons {
        text-align: center;
        margin-top: 30px;
      }
      .button {
        display: inline-block;
        padding: 14px 28px;
        background-color: #dda200;
        color: white !important;
        text-decoration: none;
        border-radius: 10px;
        font-weight: bold;
        font-size: 14px;
        margin: 5px;
      }
      .button-secondary {
        background-color: #f5f5f4;
        color: #44403c !important;
        border: 1px solid #e7e5e4;
      }
      .timestamp {
        text-align: center;
        color: #a8a29e;
        font-size: 12px;
        margin-top: 20px;
      }
      .footer {
        background-color: #fafaf9;
        padding: 24px;
        text-align: center;
        font-size: 12px;
        color: #a8a29e;
        border-top: 1px solid #e7e5e4;
      }
      .footer a {
        color: #dda200;
        text-decoration: none;
      }
    </style>
  </head>

  <body>
    <div class="container">
      <!-- Header -->
      <div class="header">
        <div class="logo-container">
          <img
            src="<%= logoUrl || 'https://your-domain.com/logo.png' %>"
            alt="Herbal Khana"
            width="40"
            height="40"
            style="border-radius: 8px"
          />
        </div>
        <h1>New Contact Message</h1>
        <p>Someone reached out through your website</p>
      </div>

      <!-- Content -->
      <div class="content">
        <span class="badge">New Message</span>

        <!-- Sender Information -->
        <div class="sender-info">
          <h3>Sender Details</h3>
          <div class="info-row">
            <span class="info-label">Name:</span>
            <span class="info-value"><%= name %></span>
          </div>
          <div class="info-row">
            <span class="info-label">Email:</span>
            <span class="info-value">
              <a href="mailto:<%= email %>"><%= email %></a>
            </span>
          </div>
          <% if (typeof ipAddress !== 'undefined' && ipAddress) { %>
          <div class="info-row">
            <span class="info-label">IP:</span>
            <span class="info-value" style="color: #78716c"
              ><%= ipAddress %></span
            >
          </div>
          <% } %>
        </div>

        <!-- Message Content -->
        <div class="message-box">
          <h3>Message</h3>
          <div class="message-subject"><%= subject %></div>
          <div class="message-content"><%= message %></div>
        </div>

        <!-- Action Buttons -->
        <div class="action-buttons">
          <a
            href="mailto:<%= email %>?subject=Re: <%= encodeURIComponent(subject) %>"
            class="button"
          >
            Reply to <%= name.split(' ')[0] %>
          </a>
          <a href="<%= adminUrl %>" class="button button-secondary">
            View in Dashboard
          </a>
        </div>

        <p class="timestamp">
          Received on <%= new Date(timestamp).toLocaleDateString('en-US', {
          weekday: 'long', year: 'numeric', month: 'long', day: 'numeric', hour:
          '2-digit', minute: '2-digit' }) %>
        </p>
      </div>

      <!-- Footer -->
      <div class="footer">
        This is an automated notification from your website contact form.
        <br />
        <a href="<%= adminUrl %>">Manage messages in admin panel</a>
        <br /><br />
        &copy; <%= new Date().getFullYear() %> Herbal Khana. All rights
        reserved.
      </div>
    </div>
  </body>
</html>
