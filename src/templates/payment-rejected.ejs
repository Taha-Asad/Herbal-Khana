<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <title>Payment Rejected</title>
    <style>
      body {
        font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
        background-color: #f5f5f4;
        margin: 0;
        padding: 0;
        color: #44403c;
      }
      .container {
        max-width: 600px;
        margin: 40px auto;
        background-color: #ffffff;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
      }
      .header {
        background: linear-gradient(135deg, #dda200 0%, #b38600 100%);
        padding: 40px 20px;
        text-align: center;
      }
      .logo-container {
        background-color: white;
        width: 60px;
        height: 60px;
        margin: 0 auto 15px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
      }
      .header h1 {
        color: white;
        margin: 0;
        font-size: 24px;
        font-weight: bold;
      }
      .content {
        padding: 40px 30px;
        text-align: center;
      }
      .greeting {
        font-size: 20px;
        font-weight: 600;
        color: #1c1917;
        margin-bottom: 16px;
      }
      .message {
        line-height: 1.6;
        margin-bottom: 24px;
        color: #57534e;
      }
      .order-box {
        background: #fafaf9;
        border: 1px dashed #e7e5e4;
        border-radius: 10px;
        padding: 16px;
        margin: 24px 0;
        text-align: left;
        font-size: 14px;
      }
      .order-box strong {
        color: #1c1917;
      }
      .button {
        display: inline-block;
        padding: 16px 32px;
        background-color: #dda200;
        color: white !important;
        text-decoration: none;
        border-radius: 10px;
        font-weight: bold;
        font-size: 16px;
        margin-top: 10px;
      }
      .footer {
        background-color: #fafaf9;
        padding: 24px;
        text-align: center;
        font-size: 12px;
        color: #a8a29e;
        border-top: 1px solid #e7e5e4;
      }
    </style>
  </head>

  <body>
    <div class="container">
      <div class="header">
        <div class="logo-container">
          <img src="https://your-domain.com/sample-logo2.jpeg" width="40" />
        </div>
        <h1>Payment Rejected</h1>
      </div>

      <div class="content">
        <div class="greeting">Hello<% if (name) { %>, <%= name %><% } %></div>

        <p class="message">
          Unfortunately, your payment proof could not be verified.
        </p>

        <div class="order-box">
          <p><strong>Order Number:</strong> <%= orderNumber %></p>
        </div>

        <p class="message">
          Your payment for order <strong><%= orderNumber %></strong> has been
          rejected. <% if (adminNote) { %> Reason: <%= adminNote %> <% } %>
        </p>

        <a href="<%= paymentProofUrl %>" class="button"> Upload New Proof </a>
      </div>

      <div class="footer">
        &copy; <%= new Date().getFullYear() %> Herbal Khana
      </div>
    </div>
  </body>
</html>
