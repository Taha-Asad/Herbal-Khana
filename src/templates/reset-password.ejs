<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Reset your password</title>
    <style>
      body {
        font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
        background-color: #f5f5f4;
        margin: 0;
        padding: 0;
        color: #44403c;
      }
      .container {
        max-width: 600px;
        margin: 40px auto;
        background-color: #ffffff;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
      }
      .header {
        background: linear-gradient(135deg, #dda200 0%, #b38600 100%);
        padding: 40px 20px;
        text-align: center;
      }
      .logo-container {
        background-color: white;
        width: 60px;
        height: 60px;
        margin: 0 auto 15px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
      }
      .header h1 {
        color: white;
        margin: 0;
        font-size: 24px;
        font-weight: bold;
      }
      .content {
        padding: 40px 30px;
        text-align: center;
      }
      .greeting {
        font-size: 20px;
        font-weight: 600;
        color: #1c1917;
        margin-bottom: 16px;
      }
      .message {
        line-height: 1.6;
        margin-bottom: 30px;
        color: #57534e;
      }
      .button {
        display: inline-block;
        padding: 16px 32px;
        background-color: #dda200;
        color: white !important;
        text-decoration: none;
        border-radius: 10px;
        font-weight: bold;
        font-size: 16px;
      }
      .link-box {
        word-break: break-all;
        font-size: 13px;
        color: #78716c;
        background: #fafaf9;
        border: 1px dashed #e7e5e4;
        border-radius: 8px;
        padding: 12px;
        margin-top: 20px;
      }
      .footer {
        background-color: #fafaf9;
        padding: 24px;
        text-align: center;
        font-size: 12px;
        color: #a8a29e;
        border-top: 1px solid #e7e5e4;
      }
    </style>
  </head>

  <body>
    <div class="container">
      <div class="header">
        <div class="logo-container">
          <!-- Make sure this URL is publicly accessible -->
          <img
            src="https://your-domain.com/sample-logo2.jpeg"
            alt="Herbal Khana"
            width="40"
            height="40"
          />
        </div>
        <h1>Password Reset Request</h1>
      </div>

      <div class="content">
        <div class="greeting">Hello, <%= name %></div>

        <p class="message">
          We received a request to reset your password for your
          <strong>Herbal Khana</strong> account. Click the button below to set a
          new password.
        </p>

        <a href="<%= resetLink %>" class="button"> Reset Password </a>

        <p class="message" style="font-size: 14px; margin-top: 30px">
          If the button doesn’t work, copy and paste this link into your
          browser:
        </p>

        <div class="link-box"><%= resetLink %></div>

        <p class="message" style="font-size: 14px; margin-top: 30px">
          This link is valid for <strong>1 hour</strong>. If you didn’t request
          a password reset, you can safely ignore this email.
        </p>
      </div>

      <div class="footer">
        &copy; <%= new Date().getFullYear() %> Herbal Khana. All rights
        reserved.
      </div>
    </div>
  </body>
</html>
